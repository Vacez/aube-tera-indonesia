# Frontend Environment Variables (Public)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Note: NEVER expose OPENAI_API_KEY or VITE_OPENAI_API_KEY on the frontend!
# OPENAI_API_KEY is configured as a secret inside Supabase Edge Functions:
# Set secret via Supabase CLI: supabase secrets set OPENAI_API_KEY=sk-...
